# DockRadar — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Scheduler ────────────────────────────────────────────
# How often to run automatic scans (in hours)
SCAN_INTERVAL_HOURS=6

# ── SMTP / Email Notifications ───────────────────────────
# Leave EMAIL_TO blank to disable email notifications.
# SMTP_USER/SMTP_PASSWORD are optional (omit them for unauthenticated relays).
# Use the "Send test" button in the UI to verify these settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your_app_password

EMAIL_FROM=dockradar@example.com
EMAIL_TO=admin@example.com

# Public URL of the DockRadar UI — adds an "Open DockRadar" link to
# notification emails. Leave blank to omit the link.
APP_URL=http://192.168.1.10:8086

# Transport (optional): port 465 auto-uses implicit SSL; otherwise STARTTLS
# is used when the server offers it. Override only if your server needs it:
# SMTP_USE_SSL=false
# SMTP_STARTTLS=true

# ── Application ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8086
LOG_FILE=dockradar.log

# Where uploaded compose files are stored. Defaults to backend/compose_files.
# (The native Linux service sets /var/lib/dockradar/compose_files.)
# COMPOSE_DIR=/var/lib/dockradar/compose_files

# Hide containers from the dashboard by container name or repository
# (comma-separated, case-insensitive). Hidden containers are not listed,
# scanned, or auto-updated.
# HIDDEN_REPOSITORY=dockradar-v2-app,my-critical-db

# ── Security ─────────────────────────────────────────────
# Optional API key. When set, every /api route except /api/health requires
# the X-Api-Key header. In the UI, store it once via the browser console:
#   localStorage.setItem('dockradar_api_key', '<your key>')
# API_KEY=change-me

# ── Registry cache TTL (seconds) ─────────────────────────
REGISTRY_CACHE_TTL=300

# ── Docker Host ─────────────────────────────────────────
# Where the Docker daemon lives (read by the Docker SDK).
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_HOST=tcp://192.168.1.10:2375
# DOCKER_HOST=ssh://user@192.168.1.10
